# Copy this to .env.staging, which git ignores, and fill it in. See STAGING.md.
# cmd/auth-setup and cmd/testpages read it from this PC, with -env-file .env.staging. The deployed server
# doesn't: its settings are in deploy/deploy-staging.sh, and its secret is in Secret Manager.

AUTH_MCP_PROJECT_ID=auth-mcp-staging
AUTH_MCP_SERVICE_ACCOUNT=auth-mcp-run@auth-mcp-staging.iam.gserviceaccount.com
AUTH_MCP_BASE_URL=https://auth-staging.healthspaces.io

# From the staging project's Google OAuth client. The secret isn't needed here: it lives in Secret Manager.
AUTH_MCP_GOOGLE_CLIENT_ID=

# Workspace domains allowed to sign in, separated by commas.
AUTH_MCP_STAFF_DOMAINS=healthspaces.com

# From the staging project's web app, for the test pages on this PC.
AUTH_MCP_FIREBASE_API_KEY=
AUTH_MCP_FIREBASE_AUTH_DOMAIN=auth-mcp-staging.firebaseapp.com
