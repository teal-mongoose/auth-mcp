# Copy this to .env.live, which git ignores, and fill it in. See STEP-A.md.
# Only for a throwaway project: the server refuses any other.

# The project's id. It must start with auth-mcp-test-.
AUTH_MCP_PROJECT_ID=auth-mcp-test-example

# The project's Firebase Admin service account. Custom tokens are signed as this account, without a key
# file. Find it in the Firebase console, under Project settings > Service accounts.
AUTH_MCP_SERVICE_ACCOUNT=firebase-adminsdk-xxxxx@auth-mcp-test-example.iam.gserviceaccount.com

# From the Google OAuth client you create. The secret is the only real secret in this file.
AUTH_MCP_GOOGLE_CLIENT_ID=
AUTH_MCP_SECRET_STAFF_GOOGLE=

# Workspace domains allowed to sign in, separated by commas.
AUTH_MCP_STAFF_DOMAINS=

# From the Firebase console, under Project settings > Your apps > Web app. These two reach browsers anyway.
AUTH_MCP_FIREBASE_API_KEY=
AUTH_MCP_FIREBASE_AUTH_DOMAIN=auth-mcp-test-example.firebaseapp.com
